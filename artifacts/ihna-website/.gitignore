# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

/.idea/*
!/.idea/runConfigurations

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env

/media

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Static stores copied by `npm run import -- static` (+ `live-files`); regenerated from ../ihna-web-2.0 (seeds/documents.ts), tracked by
# the manifest in scripts/import/out/
/public/pdf/
/public/ihna-policies/
/public/ihna-procedures/
/public/IHNA_International_Course_Guide/
/public/alumni/docs/
/public/wp-content/
/public/emailers/
/public/course-urls.json
/public/brochures/

# generated reports from scripts/dev/*
/scripts/dev/out/

# import caches (live pages read by course-live and staff, downloaded media, resized theme photos): regenerated by the steps
/scripts/import/out/cache/
/scripts/import/out/dev/

# scratch archives from Claude sessions
/.claude-tmp/
.env.backup-*
/.inventory/

# the course film originals (encoded once into public/videos/courses/)
/course-videos/

# release packages made by scripts/deploy/make-release.ps1 (database dump, media): shared with the server team, never committed
/deploy/
