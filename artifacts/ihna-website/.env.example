# Copy to .env.local on your computer only. Never commit .env.local.
# Replace the database password and generate your own Payload secret.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ihna_local
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3001
PORT=3001
DISABLE_DB_PUSH=1
DRY_RUN=1
PAYMENTS_DRY_RUN=1
TRACKING_ENABLED=0
NEXT_PUBLIC_ROBOTS=noindex
PORTAL_ENABLED=0
ENQUIRY_AUTORUN=0
# No DEFAULT_OBJECT_STORAGE_BUCKET_ID locally: uploads stay in media/.
# Optional for development; required for production-mode form testing:
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
