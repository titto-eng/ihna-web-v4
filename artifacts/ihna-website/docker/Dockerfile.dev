# Dev image for docker-compose.dev.yml: Node 22 on Debian (glibc, so sharp and the Payload native deps install cleanly).
FROM node:22.17.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client ca-certificates git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=development
EXPOSE 3001
